# Entorno
PICKMASTER_ENV=dev

# Para el build SSR del frontend (compose: PUBLIC_API_URL=http://api:8000)
# PUBLIC_API_URL=http://127.0.0.1:8000

# Base de datos (PostgreSQL en HomeLab; SQLite por defecto para desarrollo local)
# PICKMASTER_DATABASE_URL=postgresql+psycopg://pickmaster_app:CLAVE@postgres:5432/pickmaster
PICKMASTER_DATABASE_URL=sqlite:///./pickmaster.db

# Reglas del concurso (cargar con las reglas vigentes de Draftea; sin scraping)
PICKMASTER_RULES_FILE=config/contest_rules.json

# Simulación
PICKMASTER_MC_SIMS=10000

# Notificaciones (Fase 3; opcional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# PICKMASTER_SMTP_HOST=
# PICKMASTER_SMTP_PORT=465
# PICKMASTER_SMTP_USER=
# PICKMASTER_SMTP_TOKEN=

# Frontend SSR y web (compose usa PUBLIC_API_URL=http://api:8000)
# PUBLIC_API_URL=http://127.0.0.1:8000
